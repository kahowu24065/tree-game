     "contents": {
      "content": {
       "contentLanguage": "zh-TW",
       "contentText": "\n                由於降雨趨於緩和，發生大雨或豪雨的機率降低，故解除豪雨特報。\n                "
      }
     }
    },
    {
     "datasetInfo": {
      "datasetDescription": "陸上強風特報",
      "datasetLanguage": "zh-TW",
      "validTime": {
       "startTime": "2026-10-02 11:00:00",
