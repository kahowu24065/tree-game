<?xml version="1.0" encoding="utf-8"?>
<!-- 1.4.54 Android 12+: same rule as backup_rules.xml for the cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
